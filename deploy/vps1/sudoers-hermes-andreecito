# /etc/sudoers.d/hermes-andreecito
#
# andreecito opera Hermes en VPS1. Autorizado por Estephano el 2026-07-24.
#
# Instalar (valida ANTES de mover: un sudoers roto deja la máquina sin sudo):
#   sudo visudo -c -f deploy/vps1/sudoers-hermes-andreecito \
#     && sudo install -m 0440 -o root -g root deploy/vps1/sudoers-hermes-andreecito \
#          /etc/sudoers.d/hermes-andreecito
#
# ALCANCE: TODO Hermes en producción, sin fricción. Sus dos servicios, sus logs, sus dos
# Postgres, su nginx, su certificado, sus unit files y el runner de Actions que lo
# despliega. Lo que queda afuera son los OTROS productos de VPS1 (geovisor,
# certificaciones, assets, icarus, nexus…): no por desconfianza, sino porque un comando
# fuera de Hermes debería ser una decisión consciente y no un resbalón de tab.
#
# El acceso al código y a los secretos NO pasa por sudo — pasa por el grupo `hermes`
# (dueño de /srv/hermes y /srv/hermes-staging con setgid + ACL, y de server/.env en 660).
#
# NOTA SOBRE EL ALCANCE REAL: andreecito está en el grupo `docker`, y eso ya es root de
# facto en la máquina (con docker se monta / y se lee cualquier cosa). Esta lista no es
# una frontera de seguridad contra él; es un mapa de lo que le toca.

Cmnd_Alias HERMES_SVC = \
  /usr/bin/systemctl start hermes, \
  /usr/bin/systemctl stop hermes, \
  /usr/bin/systemctl restart hermes, \
  /usr/bin/systemctl status hermes, \
  /usr/bin/systemctl status hermes *, \
  /usr/bin/systemctl is-active hermes, \
  /usr/bin/systemctl show hermes *, \
  /usr/bin/journalctl -u hermes, \
  /usr/bin/journalctl -u hermes *, \
  /usr/bin/journalctl -fu hermes

# Staging: es DONDE se rompe algo sin que lo sufra una vendedora. Mismo alcance.
Cmnd_Alias HERMES_STAGING = \
  /usr/bin/systemctl start hermes-staging, \
  /usr/bin/systemctl stop hermes-staging, \
  /usr/bin/systemctl restart hermes-staging, \
  /usr/bin/systemctl status hermes-staging, \
  /usr/bin/systemctl status hermes-staging *, \
  /usr/bin/systemctl is-active hermes-staging, \
  /usr/bin/journalctl -u hermes-staging, \
  /usr/bin/journalctl -u hermes-staging *, \
  /usr/bin/journalctl -fu hermes-staging

Cmnd_Alias HERMES_DOCKER = \
  /usr/bin/docker compose -f /srv/hermes/docker-compose.yml *, \
  /usr/bin/docker compose -f /srv/hermes/docker-compose.test.yml *, \
  /usr/bin/docker compose -f /srv/hermes-staging/docker-compose.staging.yml *, \
  /usr/bin/docker logs hermes_db, \
  /usr/bin/docker logs hermes_db *, \
  /usr/bin/docker logs -f hermes_db, \
  /usr/bin/docker logs hermes_staging_db, \
  /usr/bin/docker logs hermes_staging_db *, \
  /usr/bin/docker logs -f hermes_staging_db, \
  /usr/bin/docker restart hermes_db, \
  /usr/bin/docker start hermes_db, \
  /usr/bin/docker stop hermes_db, \
  /usr/bin/docker restart hermes_staging_db, \
  /usr/bin/docker start hermes_staging_db, \
  /usr/bin/docker stop hermes_staging_db, \
  /usr/bin/docker exec hermes_db *, \
  /usr/bin/docker exec -it hermes_db *, \
  /usr/bin/docker exec hermes_staging_db *, \
  /usr/bin/docker exec -it hermes_staging_db *, \
  /usr/bin/docker inspect hermes_db, \
  /usr/bin/docker inspect hermes_staging_db

# El deploy completo. Va por script porque el `git pull` necesita la deploy key de
# `deploy`, y porque así «a mano» y «por pipeline» son la misma pieza
# (deploy/vps1/hermes-deploy.sh). El script respalda, migra, verifica y revierte solo.
Cmnd_Alias HERMES_DEPLOY = \
  /usr/local/bin/hermes-deploy, \
  /usr/local/bin/hermes-deploy *

# INSTALAR el script desde el repo. `desplegar-server.yml` hace esto en cada corrida, a
# propósito: lo que corre es siempre lo que está commiteado y revisado, y un parche
# aplicado a mano en el servidor lo pisa el próximo deploy.
#
# El destino está FIJO (`/usr/local/bin/hermes-deploy`); el `*` es solo el origen, que
# cambia con el directorio de trabajo del runner. Eso no agrega privilegio: quien tiene
# HERMES_DEPLOY ya puede ejecutar ese path como root, así que poder decidir su contenido
# es la misma facultad por otra puerta. Sin esta línea el workflow muere en el primer
# paso pidiendo contraseña.
Cmnd_Alias HERMES_INSTALAR = \
  /usr/bin/install -m 0755 -o root -g root * /usr/local/bin/hermes-deploy

# La unidad de systemd: poder cambiar cómo arranca el servicio, no solo arrancarlo.
# `sudoedit` y no `vim` a secas: edita una copia con permisos de andreecito y la mueve
# de vuelta al final, así un editor con plugins raros no corre como root.
Cmnd_Alias HERMES_UNIT = \
  sudoedit /etc/systemd/system/hermes.service, \
  sudoedit /etc/systemd/system/hermes-staging.service, \
  /usr/bin/systemctl daemon-reload, \
  /usr/bin/systemctl enable hermes, \
  /usr/bin/systemctl disable hermes, \
  /usr/bin/systemctl enable hermes-staging, \
  /usr/bin/systemctl disable hermes-staging

# El borde público de Hermes: nginx termina el TLS de hermes-api.goberna.us y hace de
# proxy al 4110 (que no se expone). Sin esto no se puede tocar el timeout del SSE ni el
# client_max_body_size de los adjuntos.
#
# ⚠️ `reload`/`restart` de nginx afectan a TODOS los sitios de VPS1, no solo a Hermes.
# Corré SIEMPRE `sudo nginx -t` antes: si la config está rota, el reload falla y nginx
# se queda con la anterior, pero un restart con config rota deja todo abajo.
Cmnd_Alias HERMES_NGINX = \
  sudoedit /etc/nginx/sites-available/hermes-api, \
  /usr/sbin/nginx -t, \
  /usr/bin/systemctl reload nginx, \
  /usr/bin/systemctl restart nginx, \
  /usr/bin/systemctl status nginx, \
  /usr/bin/systemctl status nginx *

# El certificado de hermes-api.goberna.us (dns-cloudflare, renovación automática).
# Acotado por `--cert-name`: no puede tocar los certificados de los otros dominios.
Cmnd_Alias HERMES_CERT = \
  /usr/bin/certbot certificates, \
  /usr/bin/certbot certificates *, \
  /usr/bin/certbot renew --cert-name hermes-api.goberna.us *, \
  /usr/bin/certbot renew --dry-run --cert-name hermes-api.goberna.us

# El runner self-hosted que ejecuta el pipeline. Si se cuelga, no hay despliegue.
Cmnd_Alias HERMES_RUNNER = \
  /usr/bin/systemctl start actions.runner.Goberna-Lab-hermes.vps1-hermes, \
  /usr/bin/systemctl stop actions.runner.Goberna-Lab-hermes.vps1-hermes, \
  /usr/bin/systemctl restart actions.runner.Goberna-Lab-hermes.vps1-hermes, \
  /usr/bin/systemctl status actions.runner.Goberna-Lab-hermes.vps1-hermes, \
  /usr/bin/systemctl status actions.runner.Goberna-Lab-hermes.vps1-hermes *, \
  /usr/bin/journalctl -u actions.runner.Goberna-Lab-hermes.vps1-hermes *

andreecito ALL=(root) NOPASSWD: HERMES_SVC, HERMES_STAGING, HERMES_DOCKER, \
  HERMES_DEPLOY, HERMES_INSTALAR, HERMES_UNIT, HERMES_NGINX, HERMES_CERT, HERMES_RUNNER

# `deploy` es quien corre el runner de Actions y ya tiene NOPASSWD:ALL por
# 99-deploy-bootstrap; se lista igual para que el día que se acote ese bootstrap, el
# pipeline siga funcionando.
deploy ALL=(root) NOPASSWD: HERMES_SVC, HERMES_STAGING, HERMES_DEPLOY, HERMES_INSTALAR
