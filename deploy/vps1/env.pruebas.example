# Hermes — plantilla del `.env` del entorno de PRUEBAS (/srv/hermes-staging/server/.env).
# Solo NOMBRES y valores no sensibles (regla dura #1).
#
# Existe porque ese archivo era un artefacto no versionado: si se perdía, reconstruirlo
# era arqueología. ADR 0022 dejó escrito el criterio; acá está la lista.
#
# ┌─ LEYENDA ────────────────────────────────────────────────────────────────┐
# │ 🔴 VA APAGADO   — prendido, pruebas le hace algo a una persona real.      │
# │ 🟡 VA DISTINTO  — el mismo valor en los dos entornos rompe algo.          │
# │ ⚪ IGUAL/DA IGUAL                                                          │
# └──────────────────────────────────────────────────────────────────────────┘
#
# 🔴 La base de pruebas es una COPIA de producción: adentro están los teléfonos y las
#    conversaciones de leads reales. Lo único que evita que les llegue un mensaje es
#    este archivo. Antes de agregar una variable nueva, decidí a qué grupo pertenece.

# ── Lo básico ─────────────────────────────────────────────────────────────────
# 🟡 4111 (prod es 4110)
PORT=4111
# 🟡 la base de pruebas en 5440 — nunca 5438 (prod) ni 5442 (tests)
DATABASE_URL=postgresql://hermes_staging:CAMBIAR@127.0.0.1:5440/hermes_staging

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# 🔴 SIN EXCEPCIÓN (ADR 0022). Es el candado más importante del entorno: con
#    `whatsmeow` o la Cloud API, cualquier prueba le manda un mensaje a un lead real.
#    Y como la base es copia de prod, los destinatarios existen y son correctos.
WHATSAPP_TRANSPORTE=falso
# 🔴 vacías todas. Sin sesión no hay línea, y sin línea no hay envío.
WHATSAPP_NUMERO=
WHATSAPP_NUMEROS=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_NUMERO_PROPIO=
WHATSAPP_CLOUD_API_TEST_TO=
# 🟡 propios: si coincidieran con los de prod, un webhook de Meta reenviado a mano entraría acá.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── El bot ────────────────────────────────────────────────────────────────────
# 🔴 vacío: con líneas cargadas el bot contesta solo. Y sin la key no puede aunque quiera.
BOT_LINEAS=
ANTHROPIC_API_KEY=

# ── La auto-respuesta nocturna ────────────────────────────────────────────────
# 🔴 off. El interruptor de base es la segunda llave, pero ésta es la que no depende
#    de que la copia haya traído la fila en el estado correcto.
AUTO_RESPUESTA=off

# ── Cerberus ──────────────────────────────────────────────────────────────────
# 🔴 AL DE PRUEBAS. Apuntado a app.goberna.us —como estuvo hasta hoy— registrar una
#    venta desde pruebas la escribe en el ERP de verdad.
CERBERUS_BASE_URL=https://pruebas.app.goberna.us
# 🟡 propio (Cerberus de pruebas usa el suyo para pegarle a este Hermes)
CERBERUS_WEBHOOK_TOKEN=
LANDING_WEBHOOK_TOKEN=

# ── Correo saliente ───────────────────────────────────────────────────────────
# 🔴 vacías. La vista Correos manda de verdad por SES; con la copia de prod, los
#    destinatarios son personas.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_DOMINIOS_VERIFICADOS=

# ── Meta ──────────────────────────────────────────────────────────────────────
# 🔴 vacío: es el token que usa la ingesta. Pruebas no ingesta.
META_ACCESS_TOKEN=
META_APP_ID=
META_TEST_EVENT_CODE=

# ── icarus (solo lectura) ─────────────────────────────────────────────────────
# 🟡 PUEDE apuntar al icarus real: la conexión fuerza `default_transaction_read_only`
#    del lado del servidor, así que es una garantía del motor y no una convención.
#    Con esto la vista Contactos funciona en pruebas. Dejarla vacía también es válido:
#    esa pantalla responde 503 y el resto anda igual.
ICARUS_DATABASE_URL=

# ── Secretos de sesión y servicio ─────────────────────────────────────────────
# 🟡 DISTINTOS de prod, y esto es lo que hace posible el smoke autenticado (ADR 0022).
#    Compartirlos dejaría que un token firmado en pruebas abra producción.
HERMES_SESSION_SECRET=
HERMES_ADMIN_SERVICE_TOKEN=
HERMES_CATALOGO_SERVICE_TOKEN=

# ── Ivi ───────────────────────────────────────────────────────────────────────
# ⚪ vacío: sin URL el panel dice «no configurado», que es la verdad.
IVI_URL=
IVI_SERVICE_TOKEN=

# ── Centurión (SSO) ───────────────────────────────────────────────────────────
# 🟡 secreto propio; si apunta a algo, que sea el Centurión de pruebas.
CENTURION_URL=
CENTURION_SSO_SECRET=

# ── Roles ─────────────────────────────────────────────────────────────────────
# ⚪ Desde la migración 0028 los roles viven en tabla; estas quedan de respaldo.
#    Útil ponerte a vos como supervisor/admin para ver el Dashboard entero.
HERMES_SUPERVISORES=
HERMES_ADMINS=

# ── Varios ────────────────────────────────────────────────────────────────────
SENALES_DIAS_ENFRIAMIENTO=3
LAZO_RELOJ=
