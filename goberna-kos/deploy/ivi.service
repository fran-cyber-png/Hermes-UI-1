# Ivi Analytical Engine como unidad systemd (P0.3, docs/19).
# Reemplaza el nohup del paso "Levantando el engine": el proceso ahora sobrevive
# reboots y muertes (Restart=on-failure cubre crashes y kill -9).
# La instala deploy-ivi-geografo.sh en /etc/systemd/system/ivi.service.
[Unit]
Description=Ivi Analytical Engine (goberna-kos)
# ollama.service: sin Ollama el engine solo puede contestar 503.
After=network-online.target ollama.service
Wants=network-online.target

[Service]
User=geografo
# systemd no expande ~ acá: ruta absoluta obligatoria.
WorkingDirectory=/home/geografo/ia-local
# -u: sin buffering, para que `tail -f` del log sirva (mismo motivo que el nohup viejo).
ExecStart=/usr/bin/python3 -u -m ivi.server
Restart=on-failure
RestartSec=3
# append: conserva la ruta de log que ya conocen el operador y los docs.
StandardOutput=append:/home/geografo/ia-local/ivi-server.log
StandardError=append:/home/geografo/ia-local/ivi-server.log

[Install]
WantedBy=multi-user.target
