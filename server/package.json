{
  "name": "meta-escuela-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "$comentario": "HERMES_DB_SIN_TECHO=1 en un script NO es ruido: le saca a ESE proceso los dos techos del pool (statement_timeout 20s e idle_in_transaction_session_timeout 30s, ver src/db/opciones.ts). La lleva el trabajo por LOTES sobre el corpus entero -las tres ingestas, la sincronizacion del padron, el puente de ventas, el rebuild canonico de cerberus (que corre adentro de UNA transaccion) y el backfill de pauta-, porque un corte a los 20s ahi deja datos a medias y no hay nadie esperando una respuesta. Los que consultan una ventana de dias (medir:*, piezas:resultados, cursos:gaps) y los que tocan un punado de filas (reparto:rueda, *:sembrar, routing:refrescar) NO la llevan a proposito: si alguno empieza a tardar 20s en un solo statement, eso es una noticia y hay que verla. 🔴 Esta variable NUNCA va en el .env de VPS1: ahi se la come tambien el servicio y las nueve personas se quedan sin techo. El arranque lo avisa por log (db/client.ts) justo por eso. El candado es src/db/opciones.test.ts, que cruza esta lista contra el pool que sale.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "typecheck": "tsc -b --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:adoptar": "tsx src/scripts/adoptarMigraciones.ts",
    "db:estado": "tsx src/scripts/estadoMigraciones.ts",
    "humo": "tsx src/pruebas/humoE2E.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "ingest:leads": "HERMES_DB_SIN_TECHO=1 tsx src/scripts/ingestLeads.ts",
    "cleanup:test": "tsx src/scripts/cleanupTest.ts",
    "test": "tsx --test src/**/*.test.ts",
    "test:db": "tsx src/pruebas/montarBase.ts && tsx --test src/**/*.test.db.ts",
    "ingest:interactions": "HERMES_DB_SIN_TECHO=1 tsx src/scripts/ingestInteractions.ts",
    "meta:suscribir": "tsx src/scripts/suscribirMeta.ts",
    "ingest:icarus": "HERMES_DB_SIN_TECHO=1 tsx src/scripts/ingestIcarus.ts",
    "clientes:auditar": "tsx src/scripts/auditarClientes.ts",
    "clientes:sincronizar": "HERMES_DB_SIN_TECHO=1 tsx src/scripts/sincronizarClientes.ts",
    "ventas:sincronizar": "HERMES_DB_SIN_TECHO=1 tsx src/scripts/sincronizarVentas.ts",
    "medir:correo": "tsx src/scripts/medirCorreoFichas.ts",
    "medir:cotizaciones": "tsx src/scripts/medirCotizaciones.ts",
    "medir:atencion": "tsx src/scripts/medirAtencion.ts",
    "piezas:resultados": "tsx src/scripts/resultadosDePiezas.ts",
    "plantillas:proponer": "tsx src/scripts/proponerPlantillas.ts",
    "cursos:gaps": "tsx src/scripts/gapsDeCurso.ts",
    "hechos:sembrar": "tsx src/scripts/sembrarHechos.ts",
    "reparto:rueda": "tsx src/scripts/repartoRueda.ts",
    "territorio:distritos": "tsx src/scripts/territorioDistritos.ts",
    "correos:remitentes": "tsx src/scripts/remitentesCorreo.ts",
    "equipo:sembrar": "tsx src/scripts/sembrarEquipo.ts",
    "frontera:preflight": "tsx src/scripts/preflightFrontera.ts",
    "wa:vincular": "tsx src/whatsapp/vincular.ts",
    "wa:cloud-api:probar": "tsx src/scripts/probarCloudApi.ts",
    "wa:cloud-api:limites": "tsx src/scripts/probarLimiteMedia.ts",
    "wa:permiso-llamada": "tsx src/scripts/pedirPermisoLlamada.ts",
    "auto:simulacro": "tsx src/scripts/autoSimulacro.ts",
    "bot:verificar": "tsx src/scripts/botVerificar.ts",
    "reenganche:simulacro": "tsx src/scripts/reengancheSimulacro.ts",
    "cerberus:ingestar": "HERMES_DB_SIN_TECHO=1 tsx src/scripts/cerberus.ts ingestar",
    "cerberus:proyectar": "HERMES_DB_SIN_TECHO=1 tsx src/scripts/cerberus.ts proyectar",
    "cerberus:hechos": "HERMES_DB_SIN_TECHO=1 tsx src/scripts/cerberus.ts hechos",
    "lazo": "HERMES_DB_SIN_TECHO=1 tsx src/scripts/cerberus.ts lazo",
    "backfill": "HERMES_DB_SIN_TECHO=1 tsx src/scripts/backfill.ts",
    "backfill:categorias": "tsx src/scripts/backfillCategorias.ts",
    "guion:consultoria": "tsx src/scripts/sembrarGuionConsultoria.ts",
    "campana": "tsx src/scripts/campana.ts",
    "routing:refrescar": "tsx src/scripts/routingRefrescar.ts",
    "equipo:campana": "tsx src/scripts/equipoCampana.ts",
    "sembrar:desarrollo": "tsx src/scripts/sembrarDesarrollo.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.32.0",
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1099.0",
    "@types/nodemailer": "^8.0.1",
    "@whatsmeow-node/whatsmeow-node": "0.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "nodemailer": "^9.0.3",
    "postgres": "^3.4.9",
    "qrcode": "1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2"
  }
}
