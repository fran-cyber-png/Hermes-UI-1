  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.32.0",
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1099.0",
    "@types/nodemailer": "^8.0.1",
    "@whatsmeow-node/whatsmeow-node": "0.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "nodemailer": "^9.0.3",
    "postgres": "^3.4.9",
    "qrcode": "1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2"
