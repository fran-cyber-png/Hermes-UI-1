    "plantillas:proponer": "tsx src/scripts/proponerPlantillas.ts",
    "cursos:gaps": "tsx src/scripts/gapsDeCurso.ts",
    "hechos:sembrar": "tsx src/scripts/sembrarHechos.ts",
