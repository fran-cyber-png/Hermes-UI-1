# Token de Meta Graph API (system user / business token). Hoy vive en el
# deploy de goberna-dashboard en Vercel — mismo valor, copiado acá.
META_ACCESS_TOKEN=
META_APP_ID=

# Event store (Postgres — docker compose up -d en la raíz del repo)
