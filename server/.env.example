# Copiar a .env y completar valores reales — nunca commitear .env.
# Acá van SOLO NOMBRES: ningún valor real de producción se escribe en el repo.
PORT=4100

# Token de Meta Graph API (system user / business token). Hoy vive en el
# deploy de goberna-dashboard en Vercel — mismo valor, copiado acá.
META_ACCESS_TOKEN=
META_APP_ID=

# Event store (Postgres — docker compose up -d en la raíz del repo).
# OJO: este es el de DESARROLLO. En VPS1 la base es `hermes_db` en el 5438,
# no `meta_escuela` en el 5434 — copiar este ejemplo tal cual en un server
# apunta a la base del otro producto.
DATABASE_URL=postgresql://meta_escuela:meta_escuela_dev@127.0.0.1:5434/meta_escuela

# Base para los TESTS con base (`npm run test:db`, ADR 0008). Efímera, puerto 5439
# (docker-compose.test.yml). El harness ya usa este valor por defecto; definila solo
# para apuntar a otra. NUNCA a 5438/5434: la guardia anti-prod aborta si lo hace.
TEST_DATABASE_URL=postgresql://hermes_test:hermes_test@127.0.0.1:5439/hermes_test

# Read-only al Postgres de icarus (VPS1, schema `icarus`) — segunda fuente del
# enriquecimiento de ficha (#114) y origen del PADRÓN DE CLIENTES (#133: icarus
# recibe el webhook de Cerberus en cada venta, así que tiene quién compró y
# cuánto). La usan `ingest:icarus` y `clientes:sincronizar`, y las dos fuerzan
# default_transaction_read_only=on: SOLO leen, jamás escriben en icarus.
ICARUS_DATABASE_URL=

CERBERUS_BASE_URL=https://app.goberna.us
HERMES_SESSION_SECRET=

# WhatsApp. El default de WHATSAPP_TRANSPORTE es `falso` si no se define, así que
# un server sin esta variable NO manda nada de verdad — pero deja vivas las rutas
# de simulación. En producción tiene que decir `whatsmeow`.
WHATSAPP_TRANSPORTE=falso
WHATSAPP_NUMERO=

# Correo saliente (Correos). Sin SMTP_HOST/USER/PASS el canal queda apagado y la
# UI lo dice — no finge. La cuenta sale de la misma que usa Cerberus.
# Si el puerto no es 465, el transporte exige STARTTLS (fail-closed): antes que
# mandar la contraseña en claro, no manda.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Tokens de los webhooks entrantes. Los tres son fail-closed: sin la variable,
# la ruta rechaza todo.
CERBERUS_WEBHOOK_TOKEN=
LANDING_WEBHOOK_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Relojes de fondo. `lazo` ESCRIBE a Meta (eventos de compra), por eso arranca
# apagado a propósito: `on` | `simulacion` | ausente(=off).
LAZO_RELOJ=
META_TEST_EVENT_CODE=

# AUTO-RESPUESTA fuera de horario (#125, ADR 0015 + 0016). Lo único que le escribe
# a un CLIENTE sin que nadie apriete enviar, así que arranca APAGADA y hacen falta
# DOS llaves: esta variable en `on` Y el modo de la base (`auto_respuesta_estado.modo`
# — apagada | supervisada | automatica —, que se cambia sin deploy por
# `PUT /api/autorespuesta/modo`). En `supervisada` la cola prepara pero NO manda:
# cada mensaje espera el OK de una vendedora en la bandeja de revisión.
# Antes de prenderla: `npm run auto:simulacro` — imprime el plan sin mandar nada.
AUTO_RESPUESTA=off
# Los límites, todos con default sensato; definilos solo para cambiarlos.
#   AUTO_RESPUESTA_ZONA          zona horaria de todos los relojes   (America/Lima)
#   AUTO_RESPUESTA_FRANJA        horario de la vendedora, HH:MM-HH:MM (09:00-20:00)
#   AUTO_RESPUESTA_VENTANA       horas en que es aceptable despachar  (07:30-21:00)
#   AUTO_RESPUESTA_ESPERA_MIN    minutos sin respuesta humana         (30)
#   AUTO_RESPUESTA_MAX_ESPERA_H  horas de espera desde las que YA NO se acusa
#                                recibo: más viejo que esto lo atiende la
#                                vendedora, no una plantilla (12)
#   AUTO_RESPUESTA_ESPACIADO     segundos entre envíos, min-max       (60-240)
#   AUTO_RESPUESTA_TECHO_HORA    tope por hora y número propio        (20)
#   AUTO_RESPUESTA_TECHO_DIA     tope por día y número propio         (60)
#   AUTO_RESPUESTA_GRACIA_MIN    minutos que una PREPARADA espera el OK de la
#                                vendedora antes de caducar sola     (180 — ADR 0016)
AUTO_RESPUESTA_ZONA=
AUTO_RESPUESTA_FRANJA=
AUTO_RESPUESTA_VENTANA=
AUTO_RESPUESTA_ESPERA_MIN=
AUTO_RESPUESTA_MAX_ESPERA_H=
AUTO_RESPUESTA_ESPACIADO=
AUTO_RESPUESTA_TECHO_HORA=
AUTO_RESPUESTA_TECHO_DIA=
AUTO_RESPUESTA_GRACIA_MIN=

# Ivi — el cerebro RAG en geografo (URL tailnet, HTTPS por `tailscale serve`). El
# server de Hermes le pregunta con un token de servicio que la vendedora nunca ve
# (issue #61, `POST /api/ivi/preguntar`). Fail-closed: sin estas dos, la ruta responde
# 502 y NUNCA finge «Ivi no encontró datos».
IVI_URL=
IVI_SERVICE_TOKEN=

# Etiquetas automáticas (ADR 0015): cuántos días de silencio después de mandar el
# precio hacen que una conversación cuente como «Se enfrió». Entero de 1 a 90; un
# valor fuera de rango o mal escrito se ignora y vale el default (3 días), para que
# un typo no apague la señal ni la vuelva histérica.
SENALES_DIAS_ENFRIAMIENTO=3

# Credencial de servicio del API de administración (`/api/admin`): CERBERUS la usa
# para administrar los números de WhatsApp (registrar, asignar vendedoras, vincular).
# Bearer estático, familia aparte del HMAC de vendedora (issues #50/#95). Fail-closed:
# sin esta variable en producción el server NO arranca; en dev, todo `/api/admin` da 401.
HERMES_ADMIN_SERVICE_TOKEN=

# Credencial de servicio del CATÁLOGO DE PIEZAS (`/api/catalogo`, ADR 0021): IVI la usa
# para leer todo lo que se puede decir (ids + texto + versión + estado) y poder ELEGIR
# sin inventar. **Es un secreto DISTINTO del de administración a propósito**: darle a Ivi
# el token de `/api/admin` para leer una lista le daría, de yapa, re-apuntar números de
# WhatsApp y borrar sesiones. Sin esta variable, todo `/api/catalogo` responde 503
# `falta_config` — que se distingue del 401 de credencial equivocada, o una falla de
# configuración se disfraza de token mal mandado.
HERMES_CATALOGO_SERVICE_TOKEN=
