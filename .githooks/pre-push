#!/bin/sh
#
# Bloquea el push directo a main.
#
# Por qué un hook y no protección de rama: Goberna-Lab está en plan free y hermes
# es privado, así que la API de rulesets de GitHub responde 403 ("Upgrade to
# GitHub Pro"). No hay forma de exigir PR ni CI verde del lado del servidor, así
# que el gate vive acá. Es una red local, no una garantía: protege esta máquina,
# no la web de GitHub ni otro clon.
#
# Se instala solo: `npm install` corre el script `prepare`, que fija
# core.hooksPath a .githooks. Para verificar: git config core.hooksPath
#
# Emergencia real (y solo esa): git push --no-verify

protegidas='refs/heads/main refs/heads/master'

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  for protegida in $protegidas; do
    if [ "$remote_ref" = "$protegida" ]; then
      rama=${remote_ref#refs/heads/}
      echo ""
      echo "  ✋ Push directo a '$rama' bloqueado."
      echo ""
      echo "     main es producción (VPS1, OTA). Se toca por PR:"
      echo ""
      echo "       git checkout -b feat/lo-que-sea"
      echo "       git push -u origin feat/lo-que-sea"
      echo "       gh pr create"
      echo ""
      echo "     El PR corre CI en el runner de VPS1 (vps1-hermes) y no gasta"
      echo "     minutos de GitHub. Emergencia real: git push --no-verify"
      echo ""
      exit 1
    fi
  done
done

# ─────────────────────────────────────────────────────────────────────────────
# EL TYPECHECK, ANTES DE GASTAR UNA CORRIDA DE CI
#
# `npm test` (vitest) **NO typechequea**. El 7-ago-2026 se pusheó un test que
# pasaba en vitest y rompía `tsc`: N2 quedó rojo en `main`, y con eso N3 y N4
# `skipped` — o sea que el deploy no salió, por un error que `tsc` detecta en
# treinta segundos.
#
# Solo el typecheck: lint y tests tardan minutos y el ciclo del runner es corto.
# Esto ataja la clase de error más cara (rojo en `main`) al precio más bajo.
#
# Se salta con `git push --no-verify`, igual que el bloqueo de arriba.
# ─────────────────────────────────────────────────────────────────────────────
if [ -f tsconfig.json ] && command -v npx >/dev/null 2>&1; then
  printf '  · typecheck (tsc -b)… '
  if salida="$(npx --no-install tsc -b 2>&1)"; then
    echo "ok"
  else
    echo ""
    echo ""
    echo "  ✋ El typecheck falla. CI lo rechazaría igual, pero veinte minutos después."
    echo ""
    printf '%s\n' "$salida" | head -20 | sed 's/^/     /'
    echo ""
    echo "     Si es a propósito: git push --no-verify"
    echo ""
    exit 1
  fi
fi

exit 0
