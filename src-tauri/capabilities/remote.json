{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-hermes",
  "description": "La UI viva servida desde el server (OTA) puede abrir links en el navegador del sistema y abrir la ventana del navegador de Hermes — y nada más.",
  "remote": {
    "urls": [
      "https://hermes-api.goberna.us"
    ]
  },
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-abrir-navegador",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "tel:*"
        },
        {
          "url": "mailto:*"
        }
      ]
    }
  ]
}